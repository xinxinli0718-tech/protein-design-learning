.page {
  padding: 24rpx 0 60rpx;
}

.hero {
  padding: 32rpx 28rpx 24rpx;
  display: flex;
  flex-direction: column;
}

.hero-badge {
  align-self: flex-start;
  background: #eef0fe;
  color: #4f46e5;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  margin-bottom: 16rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.hero-sub {
  color: #5c6577;
  font-size: 26rpx;
  margin-top: 10rpx;
}

.list {
  padding: 0 28rpx;
}

.task {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.task-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 14rpx 0 8rpx;
}

.task-desc {
  color: #5c6577;
  font-size: 25rpx;
  line-height: 1.65;
}

.task-go {
  margin-top: 22rpx;
}

.footer-note {
  text-align: center;
  color: #9aa2b2;
  font-size: 22rpx;
  margin-top: 24rpx;
}
