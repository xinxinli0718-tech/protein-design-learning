<view class="page">
  <view class="hero">
    <text class="hero-badge">手机看步骤 · 电脑动手做</text>
    <text class="hero-title">蛋白设计实操</text>
    <text class="hero-sub">选一个任务，跟着步骤在电脑上完成。进度自动保存在本机。</text>
  </view>

  <view class="list">
    <view class="card task" wx:for="{{tasks}}" wx:key="id" data-id="{{item.id}}" bindtap="openTask">
      <view class="badges">
        <text class="badge teal">{{item.stage}}</text>
        <text class="badge gray">{{item.est}}</text>
      </view>
      <text class="task-title">{{item.title}}</text>
      <text class="task-desc">{{item.desc}}</text>
      <view class="btn task-go">开始实操 →</view>
    </view>
  </view>

  <view class="footer-note">更多任务（RFdiffusion、从头设计、酶设计）陆续上线</view>
  <view class="about-link" bindtap="goAbout">免责声明与致谢</view>
</view>
