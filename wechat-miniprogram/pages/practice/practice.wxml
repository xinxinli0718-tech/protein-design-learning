<view class="page" wx:if="{{task}}">
  <view class="hero">
    <view class="badges">
      <text class="badge teal">{{task.stage}}</text>
      <text class="badge gray">{{task.est}}</text>
    </view>
    <text class="hero-title">{{task.title}}</text>
    <text class="hero-sub">{{task.desc}}</text>

    <view class="progress-wrap">
      <text class="progress-label">已完成 {{doneCount}} / {{total}} 步</text>
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{progressPercent}}%;"></view>
      </view>
    </view>
  </view>

  <view class="steps">
    <view wx:for="{{steps}}" wx:key="idx" id="step-{{item.idx}}" class="card step {{item.done ? 'done' : ''}}">
      <view class="step-head">
        <text class="step-num">{{item.idx + 1}}</text>
        <text class="step-title">{{item.title}}</text>
      </view>
      <text class="step-dur">⏱ {{item.dur}}</text>
      <text class="step-body">{{item.body}}</text>

      <view wx:if="{{item.expect}}" class="expect">
        <text class="expect-label">预期结果：</text>
        <text class="expect-text">{{item.expect}}</text>
      </view>

      <view wx:if="{{item.link}}" class="link-box">
        <text class="link-url">{{item.link.url}}</text>
        <button class="btn small link-btn" data-url="{{item.link.url}}" bindtap="copyLink">复制链接</button>
      </view>

      <view wx:if="{{item.errors.length}}" class="errors">
        <text class="errors-title">常见问题</text>
        <view wx:for="{{item.errors}}" wx:for-item="err" wx:key="q" class="error-item">
          <text class="error-q">{{err.q}}</text>
          <text class="error-a">{{err.a}}</text>
        </view>
      </view>

      <view wx:if="{{item.tip}}" class="tip">
        <text class="tip-label">小提示</text>
        <text class="tip-text">{{item.tip}}</text>
      </view>

      <view class="done-toggle {{item.done ? 'checked' : ''}}" data-idx="{{item.idx}}" bindtap="toggleDone">
        {{item.done ? '✓ 本步完成' : '标记本步完成'}}
      </view>
    </view>
  </view>

  <view class="nav">
    <button class="btn ghost nav-btn" bindtap="prevStep" disabled="{{current === 0}}">← 上一步</button>
    <button class="btn nav-btn" bindtap="nextStep" disabled="{{current === total - 1}}">下一步 →</button>
  </view>

  <view wx:if="{{allDone}}" class="done-banner">
    <text class="done-title">🎉 任务完成！</text>
    <text class="done-sub">{{nextTip}}</text>
  </view>
</view>
